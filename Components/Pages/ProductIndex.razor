@page "/products"
@rendermode InteractiveServer
@inject IProductRepository ProductRepository
@inject IMapper Mapper

<PageTitle>Productos - InventoryFlow</PageTitle>

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb small text-muted mb-0">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none" style="color: var(--brand-primary);">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Productos</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: var(--brand-dark);">
            <i class="bi bi-box-seam me-2" style="color: var(--brand-primary);"></i>Catálogo Maestro de Productos
        </h3>
        <span class="text-secondary small">Gestión de insumos médicos veterinarios, umbrales de stock mínimo y precios</span>
    </div>
    <button class="btn btn-primary px-3 py-2 shadow-sm fw-medium d-inline-flex align-items-center" style="background-color: var(--brand-primary); border-color: var(--brand-primary); border-radius: 8px;" @onclick="OpenCreateModal">
        <i class="bi bi-plus-lg me-2"></i>
        <span>Nuevo Producto</span>
    </button>
</div>

@if (!string.IsNullOrEmpty(feedbackMessage))
{
    <div class="alert @feedbackClass alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
        <i class="bi @feedbackIcon me-2"></i>@feedbackMessage
        <button type="button" class="btn-close" @onclick="() => feedbackMessage = null"></button>
    </div>
}

@* Barra de Filtros Estilo ERP *@
<div class="card border-0 shadow-sm mb-4" style="border-radius: 10px;">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search" style="color: var(--brand-primary);"></i>
                    </span>
                    <input type="text" class="form-control border-start-0 ps-0" 
                           placeholder="Buscar por nombre, SKU o descripción..." 
                           @bind="searchTerm" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <button class="btn btn-sm btn-link text-secondary text-decoration-none" type="button" @onclick="() => searchTerm = string.Empty">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select text-secondary" @bind="selectedCategoryFilter">
                    <option value="0">Todas las categorías</option>
                    @foreach (var cat in availableCategories)
                    {
                        <option value="@cat.IdCategory">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select text-secondary" @bind="selectedStockFilter">
                    <option value="all">Todo el stock</option>
                    <option value="low">Bajo Umbral / Crítico</option>
                    <option value="optimal">Stock Óptimo</option>
                </select>
            </div>
            <div class="col-md-2">
                <select class="form-select text-secondary" @bind="selectedStatusFilter">
                    <option value="all">Todos los estados</option>
                    <option value="active">Solo Activos</option>
                    <option value="inactive">Solo Inactivos</option>
                </select>
            </div>
            <div class="col-md-1 text-md-end text-secondary small">
                <strong style="color: var(--brand-dark);">@FilteredProducts.Count()</strong>/@products.Count
            </div>
        </div>
    </div>
</div>

@* Tabla de Productos Médicos *@
<div class="med-card overflow-hidden">
    <div class="table-responsive">
        <table class="table med-table align-middle">
            <thead>
                <tr>
                    <th scope="col" style="width: 140px;">SKU / Código</th>
                    <th scope="col">Producto y Presentación</th>
                    <th scope="col" style="width: 200px;">Categoría</th>
                    <th scope="col" class="text-end" style="width: 120px;">Precio Unit.</th>
                    <th scope="col" class="text-center" style="width: 120px;">Umbral Mín.</th>
                    <th scope="col" class="text-center" style="width: 150px;">Stock Total</th>
                    <th scope="col" class="text-center" style="width: 110px;">Estado</th>
                    <th scope="col" class="text-end" style="width: 130px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr>
                        <td colspan="8" class="text-center py-5">
                            <div class="spinner-border text-primary" role="status" style="color: var(--brand-primary) !important;">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <div class="text-secondary mt-3 fw-medium">Cargando catálogo de productos...</div>
                        </td>
                    </tr>
                }
                else if (!FilteredProducts.Any())
                {
                    <tr>
                        <td colspan="8" class="text-center py-5 text-secondary">
                            <div class="kpi-icon blue mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                                <i class="bi bi-box-seam"></i>
                            </div>
                            <div class="fw-semibold fs-5 mb-1 text-dark">No se encontraron productos</div>
                            <small class="text-secondary">Intenta con otros filtros o agrega un nuevo producto al catálogo maestro.</small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var prod in FilteredProducts)
                    {
                        <tr>
                            <td>
                                <span class="badge-sku-pill">@prod.Sku</span>
                            </td>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="kpi-icon blue me-3" style="width: 40px; height: 40px; font-size: 1.1rem; border-radius: 10px;">
                                        <i class="bi bi-capsule"></i>
                                    </div>
                                    <div>
                                        <span class="fw-bold d-block" style="color: var(--brand-dark); font-size: 0.95rem;">@prod.Name</span>
                                        <span class="text-secondary" style="font-size: 0.82rem; line-height: 1.3; display: block; max-width: 320px;">
                                            @prod.Description
                                        </span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="badge-type-pill">
                                    <i class="bi bi-tag" style="color: var(--brand-primary); font-size: 0.85rem;"></i>
                                    @(prod.CategoryName ?? "Sin categoría")
                                </span>
                            </td>
                            <td class="text-end fw-semibold" style="color: var(--brand-dark);">
                                $@prod.UnitPrice.ToString("N2")
                            </td>
                            <td class="text-center">
                                <span class="badge rounded-pill bg-light text-secondary border px-2 py-1" style="font-size: 0.82rem;">
                                    @prod.MinimumStockThreshold u.
                                </span>
                            </td>
                            <td class="text-center">
                                @if (prod.TotalStock == 0)
                                {
                                    <span class="badge-stock-out" title="Sin existencias en ninguna sucursal">
                                        <i class="bi bi-exclamation-octagon-fill"></i> 0 u. (Agotado)
                                    </span>
                                }
                                else if (prod.TotalStock <= prod.MinimumStockThreshold)
                                {
                                    <span class="badge-stock-low" title="Stock por debajo o igual al umbral mínimo establecido">
                                        <i class="bi bi-exclamation-triangle-fill"></i> @prod.TotalStock u. (Bajo)
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-stock-optimal" title="Stock en nivel adecuado">
                                        <i class="bi bi-check-circle-fill"></i> @prod.TotalStock u.
                                    </span>
                                }
                            </td>
                            <td class="text-center">
                                @if (prod.IsActive)
                                {
                                    <span class="badge-status-active">
                                        <i class="bi bi-record-fill" style="font-size: 0.65rem;"></i> Activo
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status-inactive">
                                        <i class="bi bi-dash-circle" style="font-size: 0.75rem;"></i> Inactivo
                                    </span>
                                }
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-brand-ghost" title="Editar producto" @onclick="() => OpenEditModal(prod)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-outline-danger ms-1" style="border-radius: 10px; border-color: rgba(220,53,69,0.25);" title="Eliminar producto" @onclick="() => OpenDeleteModal(prod)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* MODAL CREAR / EDITAR PRODUCTO *@
@if (showModal)
{
    <div class="modal fade show d-block modal-backdrop-blur" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content modal-medical-content border-0">
                <div class="modal-header modal-medical-header">
                    <h5 class="modal-title fw-bold d-flex align-items-center">
                        <i class="bi @(isEditing ? "bi-pencil-square" : "bi-plus-circle") me-2" style="color: var(--brand-ice);"></i>
                        @(isEditing ? "Editar Producto Veterinario" : "Registrar Nuevo Producto Insumo")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    @if (isEditing)
                    {
                        <EditForm Model="updateModel" OnValidSubmit="HandleUpdate">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger small mb-3" />

                            <div class="row g-3 mb-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold" style="color: var(--brand-dark);">Nombre del Producto / Fármaco</label>
                                    <InputText class="form-control rounded-3" @bind-Value="updateModel.Name" placeholder="Ej. Amoxicilina + Ácido Clavulánico 250mg" />
                                    <ValidationMessage For="() => updateModel.Name" class="text-danger small" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold" style="color: var(--brand-dark);">Código SKU / Barras</label>
                                    <InputText class="form-control rounded-3" @bind-Value="updateModel.Sku" placeholder="Ej. MED-AMX-250" />
                                    <ValidationMessage For="() => updateModel.Sku" class="text-danger small" />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" style="color: var(--brand-dark);">Categoría</label>
                                    <InputSelect class="form-select rounded-3" @bind-Value="updateModel.IdCategory">
                                        <option value="0">-- Seleccione una categoría --</option>
                                        @foreach (var cat in availableCategories)
                                        {
                                            <option value="@cat.IdCategory">@cat.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => updateModel.IdCategory" class="text-danger small" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold" style="color: var(--brand-dark);">Precio Unitario ($)</label>
                                    <InputNumber class="form-control rounded-3" @bind-Value="updateModel.UnitPrice" step="0.01" />
                                    <ValidationMessage For="() => updateModel.UnitPrice" class="text-danger small" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold" style="color: var(--brand-dark);">Umbral Mínimo</label>
                                    <InputNumber class="form-control rounded-3" @bind-Value="updateModel.MinimumStockThreshold" />
                                    <ValidationMessage For="() => updateModel.MinimumStockThreshold" class="text-danger small" />
                                </div>
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="color: var(--brand-dark);">Descripción y Presentación</label>
                                <InputTextArea class="form-control rounded-3" rows="3" @bind-Value="updateModel.Description" placeholder="Presentación comercial, miligramos, laboratorio o indicaciones..." />
                                <ValidationMessage For="() => updateModel.Description" class="text-danger small" />
                            </div>

                            <div class="mb-4 form-check form-switch">
                                <InputCheckbox class="form-check-input" id="isActiveProductCheck" @bind-Value="updateModel.IsActive" />
                                <label class="form-check-label fw-semibold" for="isActiveProductCheck" style="color: var(--brand-dark);">Producto Activo para Distribución y Venta</label>
                            </div>

                            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                                <button type="button" class="btn btn-light rounded-3 px-3 text-secondary" @onclick="CloseModal">Cancelar</button>
                                <button type="submit" class="btn-brand-primary" disabled="@isSaving">
                                    @(isSaving ? "Guardando..." : "Actualizar Producto")
                                </button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="createModel" OnValidSubmit="HandleCreate">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger small mb-3" />

                            <div class="row g-3 mb-3">
                                <div class="col-md-8">
                                    <label class="form-label fw-semibold" style="color: var(--brand-dark);">Nombre del Producto / Fármaco</label>
                                    <InputText class="form-control rounded-3" @bind-Value="createModel.Name" placeholder="Ej. Bravecto Comprimido 10 a 20 kg" />
                                    <ValidationMessage For="() => createModel.Name" class="text-danger small" />
                                </div>
                                <div class="col-md-4">
                                    <label class="form-label fw-semibold" style="color: var(--brand-dark);">Código SKU / Barras</label>
                                    <InputText class="form-control rounded-3" @bind-Value="createModel.Sku" placeholder="Ej. PAR-BRV-1020" />
                                    <ValidationMessage For="() => createModel.Sku" class="text-danger small" />
                                </div>
                            </div>

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label class="form-label fw-semibold" style="color: var(--brand-dark);">Categoría</label>
                                    <InputSelect class="form-select rounded-3" @bind-Value="createModel.IdCategory">
                                        <option value="0">-- Seleccione una categoría --</option>
                                        @foreach (var cat in availableCategories)
                                        {
                                            <option value="@cat.IdCategory">@cat.Name</option>
                                        }
                                    </InputSelect>
                                    <ValidationMessage For="() => createModel.IdCategory" class="text-danger small" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold" style="color: var(--brand-dark);">Precio Unitario ($)</label>
                                    <InputNumber class="form-control rounded-3" @bind-Value="createModel.UnitPrice" step="0.01" />
                                    <ValidationMessage For="() => createModel.UnitPrice" class="text-danger small" />
                                </div>
                                <div class="col-md-3">
                                    <label class="form-label fw-semibold" style="color: var(--brand-dark);">Umbral Mínimo</label>
                                    <InputNumber class="form-control rounded-3" @bind-Value="createModel.MinimumStockThreshold" />
                                    <ValidationMessage For="() => createModel.MinimumStockThreshold" class="text-danger small" />
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label fw-semibold" style="color: var(--brand-dark);">Descripción y Presentación</label>
                                <InputTextArea class="form-control rounded-3" rows="3" @bind-Value="createModel.Description" placeholder="Presentación comercial, concentración, mililitros o indicaciones generales..." />
                                <ValidationMessage For="() => createModel.Description" class="text-danger small" />
                            </div>

                            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                                <button type="button" class="btn btn-light rounded-3 px-3 text-secondary" @onclick="CloseModal">Cancelar</button>
                                <button type="submit" class="btn-brand-primary" disabled="@isSaving">
                                    @(isSaving ? "Guardando..." : "Registrar Producto")
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* MODAL CONFIRMAR ELIMINACIÓN *@
@if (showDeleteModal)
{
    <div class="modal fade show d-block modal-backdrop-blur" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-medical-content border-0">
                <div class="modal-header bg-danger text-white py-3 px-4 border-0">
                    <h5 class="modal-title fw-bold d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Retiro de Producto
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    <p class="mb-1 text-secondary">
                        ¿Estás seguro de que deseas retirar del catálogo maestro el siguiente producto?
                    </p>
                    <div class="p-3 my-3 rounded-3" style="background: #FFF1F2; border: 1px solid #FFE4E6;">
                        <span class="badge-sku-pill mb-1 d-inline-block">@productToDelete?.Sku</span>
                        <strong class="text-danger fs-5 d-block">@productToDelete?.Name</strong>
                        <small class="text-secondary">Categoría: @(productToDelete?.CategoryName ?? "Sin categoría") | Stock Total: @(productToDelete?.TotalStock ?? 0) u.</small>
                    </div>
                    <small class="text-muted d-block">
                        Si el producto tiene lotes o existencias registradas en alguna sucursal, no podrá eliminarse por integridad referencial.
                    </small>
                </div>
                <div class="modal-footer bg-white border-top py-3 px-4">
                    <button type="button" class="btn btn-light rounded-3 px-3 text-secondary" @onclick="CloseDeleteModal">Cancelar</button>
                    <button type="button" class="btn btn-danger rounded-3 px-4 fw-semibold" @onclick="ExecuteDeleteAsync" disabled="@isDeleting">
                        @(isDeleting ? "Eliminando..." : "Eliminar Definitivamente")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<ProductDto> products = new();
    private List<Category> availableCategories = new();
    private string searchTerm = string.Empty;
    private int selectedCategoryFilter = 0;
    private string selectedStockFilter = "all";
    private string selectedStatusFilter = "all";

    private bool isLoading = true;
    private bool showModal = false;
    private bool showDeleteModal = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private bool isDeleting = false;
    private int selectedProductId;
    private ProductDto? productToDelete;

    private CreateProductDto createModel = new();
    private UpdateProductDto updateModel = new();

    private string? feedbackMessage;
    private string feedbackClass = "alert-success";
    private string feedbackIcon = "bi-check-circle";

    private IEnumerable<ProductDto> FilteredProducts =>
        products.Where(p =>
            (string.IsNullOrWhiteSpace(searchTerm) ||
             (p.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
             (p.Sku?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
             (p.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)) &&
            (selectedCategoryFilter == 0 || p.IdCategory == selectedCategoryFilter) &&
            (selectedStatusFilter == "all" ||
             (selectedStatusFilter == "active" && p.IsActive) ||
             (selectedStatusFilter == "inactive" && !p.IsActive)) &&
            (selectedStockFilter == "all" ||
             (selectedStockFilter == "low" && p.TotalStock <= p.MinimumStockThreshold) ||
             (selectedStockFilter == "optimal" && p.TotalStock > p.MinimumStockThreshold))
        );

    protected override async Task OnInitializedAsync()
    {
        await LoadCategoriesAsync();
        await LoadProductsAsync();
    }

    private async Task LoadCategoriesAsync()
    {
        try
        {
            var cats = await ProductRepository.GetCategoriesAsync();
            availableCategories = cats.ToList();
        }
        catch
        {
            availableCategories = new();
        }
    }

    private async Task LoadProductsAsync()
    {
        isLoading = true;
        try
        {
            var rawProducts = await ProductRepository.GetProductsAsync();
            products = Mapper.Map<List<ProductDto>>(rawProducts);
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error al cargar productos: {ex.Message}", false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        isEditing = false;
        createModel = new CreateProductDto
        {
            IdCategory = availableCategories.FirstOrDefault()?.IdCategory ?? 0,
            MinimumStockThreshold = 5,
            UnitPrice = 0.00m
        };
        showModal = true;
    }

    private void OpenEditModal(ProductDto product)
    {
        isEditing = true;
        selectedProductId = product.IdProduct;
        updateModel = new UpdateProductDto
        {
            Name = product.Name,
            Sku = product.Sku,
            Description = product.Description,
            IdCategory = product.IdCategory,
            MinimumStockThreshold = product.MinimumStockThreshold,
            UnitPrice = product.UnitPrice,
            IsActive = product.IsActive
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        isSaving = false;
    }

    private async Task HandleCreate()
    {
        isSaving = true;
        try
        {
            if (await ProductRepository.ProductExistsBySkuAsync(createModel.Sku))
            {
                ShowFeedback($"Ya existe un producto registrado con el SKU/Código '{createModel.Sku}'.", false);
                isSaving = false;
                return;
            }

            if (await ProductRepository.ProductExistsByNameAsync(createModel.Name))
            {
                ShowFeedback($"Ya existe un producto registrado con el nombre '{createModel.Name}'.", false);
                isSaving = false;
                return;
            }

            var product = Mapper.Map<Product>(createModel);
            product.IsActive = true;
            product.CreationDate = DateTime.UtcNow;

            var success = await ProductRepository.CreateProductAsync(product);

            if (success)
            {
                ShowFeedback($"Producto '{product.Name}' registrado exitosamente.", true);
                CloseModal();
                await LoadProductsAsync();
            }
            else
            {
                ShowFeedback("No se pudo guardar el producto en la base de datos.", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleUpdate()
    {
        isSaving = true;
        try
        {
            var existingProduct = await ProductRepository.GetProductAsync(selectedProductId);
            if (existingProduct == null)
            {
                ShowFeedback("No se encontró el producto a actualizar.", false);
                return;
            }

            if (!string.Equals(existingProduct.Sku.Trim(), updateModel.Sku.Trim(), StringComparison.OrdinalIgnoreCase) &&
                await ProductRepository.ProductExistsBySkuAsync(updateModel.Sku))
            {
                ShowFeedback($"Ya existe otro producto con el código SKU '{updateModel.Sku}'.", false);
                return;
            }

            if (!string.Equals(existingProduct.Name.Trim(), updateModel.Name.Trim(), StringComparison.OrdinalIgnoreCase) &&
                await ProductRepository.ProductExistsByNameAsync(updateModel.Name))
            {
                ShowFeedback($"Ya existe otro producto con el nombre '{updateModel.Name}'.", false);
                return;
            }

            var product = Mapper.Map<Product>(updateModel);
            product.IdProduct = selectedProductId;
            product.CreationDate = existingProduct.CreationDate;

            var success = await ProductRepository.UpdateProductAsync(product);

            if (success)
            {
                ShowFeedback($"Producto '{product.Name}' actualizado correctamente.", true);
                CloseModal();
                await LoadProductsAsync();
            }
            else
            {
                ShowFeedback("No se pudo actualizar el producto.", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenDeleteModal(ProductDto product)
    {
        productToDelete = product;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        productToDelete = null;
        isDeleting = false;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (productToDelete == null) return;

        isDeleting = true;
        try
        {
            var entity = await ProductRepository.GetProductAsync(productToDelete.IdProduct);
            if (entity != null)
            {
                var success = await ProductRepository.DeleteProductAsync(entity);
                if (success)
                {
                    ShowFeedback($"Producto '{productToDelete.Name}' eliminado del catálogo.", true);
                    CloseDeleteModal();
                    await LoadProductsAsync();
                }
                else
                {
                    ShowFeedback("No se pudo eliminar el producto.", false);
                }
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"No se puede eliminar: {ex.Message}. Verifique si tiene inventario o movimientos asociados.", false);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ShowFeedback(string message, bool isSuccess)
    {
        feedbackMessage = message;
        feedbackClass = isSuccess ? "alert-success" : "alert-danger";
        feedbackIcon = isSuccess ? "bi-check-circle" : "bi-exclamation-triangle";
    }
}
