@page "/"

<PageTitle>Inicio - InventoryFlow</PageTitle>

<div class="row justify-content-center">
    <div class="col-md-10">
        <div class="card shadow-sm border-0 mt-4 p-4 text-center">
            <h1 class="display-5 fw-bold text-primary">
                📦 Bienvenido a InventoryFlow
            </h1>
            <p class="lead text-secondary mt-3">
                Sistema modular de gestión y control de inventarios desarrollado con ASP.NET Core Web API y Blazor.
            </p>
            <div class="d-flex justify-content-center gap-3 mt-4 flex-wrap">
                <a href="/stores" class="btn btn-primary btn-lg px-4" style="background-color: var(--brand-primary); border-color: var(--brand-primary);">
                    <i class="bi bi-shop me-2"></i> Sucursales
                </a>
                <a href="/products" class="btn btn-outline-primary btn-lg px-4" style="color: var(--brand-primary); border-color: var(--brand-primary);">
                    <i class="bi bi-box-seam me-2"></i> Productos
                </a>
                <a href="/inventory" class="btn btn-outline-primary btn-lg px-4" style="color: var(--brand-primary); border-color: var(--brand-primary);">
                    <i class="bi bi-boxes me-2"></i> Inventario por Bodega
                </a>
            </div>
        </div>
    </div>
</div>
