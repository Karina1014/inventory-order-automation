@page "/stores"
@rendermode InteractiveServer
@inject IStoreRepository StoreRepository
@inject IMapper Mapper

<PageTitle>Sucursales - InventoryFlow</PageTitle>

<nav aria-label="breadcrumb" class="mb-2">
    <ol class="breadcrumb small text-muted mb-0">
        <li class="breadcrumb-item"><a href="/" class="text-decoration-none" style="color: var(--brand-primary);">Inicio</a></li>
        <li class="breadcrumb-item active" aria-current="page">Sucursales</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
    <div>
        <h3 class="fw-bold mb-1" style="color: var(--brand-dark);">
            <i class="bi bi-hospital me-2" style="color: var(--brand-primary);"></i>Catálogo de Sucursales
        </h3>
        <span class="text-secondary small">Administración de sucursales, consultorios y puntos de distribución de inventario</span>
    </div>
    <button class="btn btn-primary px-3 py-2 shadow-sm fw-medium d-inline-flex align-items-center" style="background-color: var(--brand-primary); border-color: var(--brand-primary); border-radius: 8px;" @onclick="OpenCreateModal">
        <i class="bi bi-plus-lg me-2"></i>
        <span>Nueva Sucursal</span>
    </button>
</div>

@if (!string.IsNullOrEmpty(feedbackMessage))
{
    <div class="alert @feedbackClass alert-dismissible fade show shadow-sm border-0 rounded-3 mb-4" role="alert">
        <i class="bi @feedbackIcon me-2"></i>@feedbackMessage
        <button type="button" class="btn-close" @onclick="() => feedbackMessage = null"></button>
    </div>
}

@* Barra de Filtros Estilo ERP (Referencia Adelina) *@
<div class="card border-0 shadow-sm mb-4" style="border-radius: 10px;">
    <div class="card-body p-3">
        <div class="row g-2 align-items-center">
            <div class="col-md-4">
                <div class="input-group">
                    <span class="input-group-text bg-white border-end-0 text-muted">
                        <i class="bi bi-search" style="color: var(--brand-primary);"></i>
                    </span>
                    <input type="text" class="form-control border-start-0 ps-0" 
                           placeholder="Buscar por nombre o descripción..." 
                           @bind="searchTerm" @bind:event="oninput" />
                    @if (!string.IsNullOrEmpty(searchTerm))
                    {
                        <button class="btn btn-sm btn-link text-secondary text-decoration-none" type="button" @onclick="() => searchTerm = string.Empty">
                            <i class="bi bi-x-circle-fill"></i>
                        </button>
                    }
                </div>
            </div>
            <div class="col-md-3">
                <select class="form-select text-secondary" @bind="selectedTypeFilter">
                    <option value="0">Todos los tipos</option>
                    @foreach (var type in availableTypes)
                    {
                        <option value="@type.IdStoreType">@type.Name</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <select class="form-select text-secondary" @bind="selectedStatusFilter">
                    <option value="all">Todos los estados</option>
                    <option value="active">Solo Operativas</option>
                    <option value="inactive">Solo Inactivas</option>
                </select>
            </div>
            <div class="col-md-2 text-md-end text-secondary small">
                Total: <strong style="color: var(--brand-dark);">@FilteredStores.Count()</strong> de @stores.Count
            </div>
        </div>
    </div>
</div>

@* Tabla Médica *@
<div class="med-card overflow-hidden">
    <div class="table-responsive">
        <table class="table med-table align-middle">
            <thead>
                <tr>
                    <th scope="col">Sucursal Médica</th>
                    <th scope="col">Descripción y Ubicación</th>
                    <th scope="col">Especialidad / Tipo</th>
                    <th scope="col" class="text-center" style="width: 130px;">Estado</th>
                    <th scope="col" style="width: 160px;">Registro</th>
                    <th scope="col" class="text-end" style="width: 140px;">Acciones</th>
                </tr>
            </thead>
            <tbody>
                @if (isLoading)
                {
                    <tr>
                        <td colspan="6" class="text-center py-5">
                            <div class="spinner-border text-primary" role="status" style="color: var(--brand-primary) !important;">
                                <span class="visually-hidden">Cargando...</span>
                            </div>
                            <div class="text-secondary mt-3 fw-medium">Cargando sedes médicas...</div>
                        </td>
                    </tr>
                }
                else if (!FilteredStores.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-secondary">
                            <div class="kpi-icon blue mx-auto mb-3" style="width: 64px; height: 64px; font-size: 2rem;">
                                <i class="bi bi-inbox"></i>
                            </div>
                            <div class="fw-semibold fs-5 mb-1 text-dark">No se encontraron sucursales</div>
                            <small class="text-secondary">Intenta con otro término de búsqueda o registra una nueva sede.</small>
                        </td>
                    </tr>
                }
                else
                {
                    @foreach (var store in FilteredStores)
                    {
                        <tr>
                            <td>
                                <div class="d-flex align-items-center">
                                    <div class="kpi-icon blue me-3" style="width: 42px; height: 42px; font-size: 1.15rem; border-radius: 12px;">
                                        <i class="bi bi-geo-alt-fill"></i>
                                    </div>
                                    <div>
                                        <span class="fw-bold d-block" style="color: var(--brand-dark); font-size: 0.98rem;">@store.Name</span>
                                    </div>
                                </div>
                            </td>
                            <td>
                                <span class="text-secondary" style="font-size: 0.9rem; line-height: 1.45; display: block; max-width: 440px;">
                                    @store.Description
                                </span>
                            </td>
                            <td>
                                <span class="badge-type-pill">
                                    <i class="bi bi-shield-plus" style="color: var(--brand-primary); font-size: 0.85rem;"></i>
                                    @(store.StoreTypeName ?? "No asignado")
                                </span>
                            </td>
                            <td class="text-center">
                                @if (store.IsActive)
                                {
                                    <span class="badge-status-active">
                                        <i class="bi bi-record-fill" style="font-size: 0.65rem;"></i> Operativa
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status-inactive">
                                        <i class="bi bi-dash-circle" style="font-size: 0.75rem;"></i> Inactiva
                                    </span>
                                }
                            </td>
                            <td class="text-secondary" style="font-size: 0.88rem;">
                                <i class="bi bi-calendar3 me-1 text-muted"></i>
                                @store.CreationDate.ToLocalTime().ToString("dd/MM/yyyy")
                            </td>
                            <td class="text-end">
                                <div class="btn-group btn-group-sm">
                                    <button class="btn btn-brand-ghost" title="Editar sucursal" @onclick="() => OpenEditModal(store)">
                                        <i class="bi bi-pencil-square"></i>
                                    </button>
                                    <button class="btn btn-outline-danger ms-1" style="border-radius: 10px; border-color: rgba(220,53,69,0.25);" title="Eliminar" @onclick="() => OpenDeleteModal(store)">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </td>
                        </tr>
                    }
                }
            </tbody>
        </table>
    </div>
</div>

@* MODAL CREAR / EDITAR *@
@if (showModal)
{
    <div class="modal fade show d-block modal-backdrop-blur" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-medical-content border-0">
                <div class="modal-header modal-medical-header">
                    <h5 class="modal-title fw-bold d-flex align-items-center">
                        <i class="bi @(isEditing ? "bi-pencil-square" : "bi-plus-circle") me-2" style="color: var(--brand-ice);"></i>
                        @(isEditing ? "Editar Sucursal Médica" : "Nueva Sucursal Médica")
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseModal"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    @if (isEditing)
                    {
                        <EditForm Model="updateModel" OnValidSubmit="HandleUpdate">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger small mb-3" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="color: var(--brand-dark);">Nombre de la Sucursal</label>
                                <InputText class="form-control rounded-3" @bind-Value="updateModel.Name" placeholder="Ej. Med Vet - Sede Principal" />
                                <ValidationMessage For="() => updateModel.Name" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="color: var(--brand-dark);">Descripción y Ubicación</label>
                                <InputTextArea class="form-control rounded-3" rows="3" @bind-Value="updateModel.Description" placeholder="Ubicación o servicios ofrecidos..." />
                                <ValidationMessage For="() => updateModel.Description" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="color: var(--brand-dark);">Tipo de Sucursal</label>
                                <InputSelect class="form-select rounded-3" @bind-Value="updateModel.IdStoreType">
                                    <option value="0">-- Seleccione un tipo --</option>
                                    @foreach (var type in availableTypes)
                                    {
                                        <option value="@type.IdStoreType">@type.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => updateModel.IdStoreType" class="text-danger small" />
                            </div>

                            <div class="mb-4 form-check form-switch">
                                <InputCheckbox class="form-check-input" id="isActiveCheck" @bind-Value="updateModel.IsActive" />
                                <label class="form-check-label fw-semibold" for="isActiveCheck" style="color: var(--brand-dark);">Sede Operativa</label>
                            </div>

                            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                                <button type="button" class="btn btn-light rounded-3 px-3 text-secondary" @onclick="CloseModal">Cancelar</button>
                                <button type="submit" class="btn-brand-primary" disabled="@isSaving">
                                    @(isSaving ? "Guardando..." : "Actualizar Sede")
                                </button>
                            </div>
                        </EditForm>
                    }
                    else
                    {
                        <EditForm Model="createModel" OnValidSubmit="HandleCreate">
                            <DataAnnotationsValidator />
                            <ValidationSummary class="text-danger small mb-3" />

                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="color: var(--brand-dark);">Nombre de la Sucursal</label>
                                <InputText class="form-control rounded-3" @bind-Value="createModel.Name" placeholder="Ej. Med Vet - Norte" />
                                <ValidationMessage For="() => createModel.Name" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="color: var(--brand-dark);">Descripción y Ubicación</label>
                                <InputTextArea class="form-control rounded-3" rows="3" @bind-Value="createModel.Description" placeholder="Ubicación o servicios ofrecidos..." />
                                <ValidationMessage For="() => createModel.Description" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label fw-semibold" style="color: var(--brand-dark);">Tipo de Sucursal</label>
                                <InputSelect class="form-select rounded-3" @bind-Value="createModel.IdStoreType">
                                    <option value="0">-- Seleccione un tipo --</option>
                                    @foreach (var type in availableTypes)
                                    {
                                        <option value="@type.IdStoreType">@type.Name</option>
                                    }
                                </InputSelect>
                                <ValidationMessage For="() => createModel.IdStoreType" class="text-danger small" />
                            </div>

                            <div class="d-flex justify-content-end gap-2 pt-2 border-top">
                                <button type="button" class="btn btn-light rounded-3 px-3 text-secondary" @onclick="CloseModal">Cancelar</button>
                                <button type="submit" class="btn-brand-primary" disabled="@isSaving">
                                    @(isSaving ? "Guardando..." : "Registrar Sede")
                                </button>
                            </div>
                        </EditForm>
                    }
                </div>
            </div>
        </div>
    </div>
}

@* MODAL CONFIRMAR ELIMINACIÓN *@
@if (showDeleteModal)
{
    <div class="modal fade show d-block modal-backdrop-blur" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content modal-medical-content border-0">
                <div class="modal-header bg-danger text-white py-3 px-4 border-0">
                    <h5 class="modal-title fw-bold d-flex align-items-center">
                        <i class="bi bi-exclamation-triangle-fill me-2"></i>Confirmar Baja de Sede
                    </h5>
                    <button type="button" class="btn-close btn-close-white" @onclick="CloseDeleteModal"></button>
                </div>
                <div class="modal-body p-4 bg-white">
                    <p class="mb-1 text-secondary">
                        ¿Estás seguro de que deseas retirar del sistema la sucursal:
                    </p>
                    <div class="p-3 my-3 rounded-3" style="background: #FFF1F2; border: 1px solid #FFE4E6;">
                        <strong class="text-danger fs-5 d-block">@storeToDelete?.Name</strong>
                        <small class="text-secondary">@(storeToDelete?.StoreTypeName ?? "Sin tipo asignado")</small>
                    </div>
                    <small class="text-muted d-block">Esta acción eliminará los registros asociados de forma permanente.</small>
                </div>
                <div class="modal-footer bg-white border-top py-3 px-4">
                    <button type="button" class="btn btn-light rounded-3 px-3 text-secondary" @onclick="CloseDeleteModal">Cancelar</button>
                    <button type="button" class="btn btn-danger rounded-3 px-4 fw-semibold" @onclick="ExecuteDeleteAsync" disabled="@isDeleting">
                        @(isDeleting ? "Eliminando..." : "Eliminar Definitivamente")
                    </button>
                </div>
            </div>
        </div>
    </div>
}

@code {
    private List<StoreDto> stores = new();
    private List<StoreType> availableTypes = new();
    private string searchTerm = string.Empty;
    private bool isLoading = true;
    private bool showModal = false;
    private bool showDeleteModal = false;
    private bool isEditing = false;
    private bool isSaving = false;
    private bool isDeleting = false;
    private int selectedStoreId;
    private StoreDto? storeToDelete;

    private CreateStoreDto createModel = new();
    private UpdateStoreDto updateModel = new();

    private string? feedbackMessage;
    private string feedbackClass = "alert-success";
    private string feedbackIcon = "bi-check-circle";

    private int selectedTypeFilter = 0;
    private string selectedStatusFilter = "all";

    private IEnumerable<StoreDto> FilteredStores =>
        stores.Where(s =>
            (string.IsNullOrWhiteSpace(searchTerm) ||
             (s.Name?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true) ||
             (s.Description?.Contains(searchTerm, StringComparison.OrdinalIgnoreCase) == true)) &&
            (selectedTypeFilter == 0 || s.IdStoreType == selectedTypeFilter) &&
            (selectedStatusFilter == "all" ||
             (selectedStatusFilter == "active" && s.IsActive) ||
             (selectedStatusFilter == "inactive" && !s.IsActive))
        );

    protected override async Task OnInitializedAsync()
    {
        await LoadStoreTypesAsync();
        await LoadStoresAsync();
    }

    private async Task LoadStoreTypesAsync()
    {
        try
        {
            var types = await StoreRepository.GetStoreTypesAsync();
            availableTypes = types.ToList();
        }
        catch
        {
            availableTypes = new();
        }
    }

    private async Task LoadStoresAsync()
    {
        isLoading = true;
        try
        {
            var rawStores = await StoreRepository.GetStoresAsync();
            stores = Mapper.Map<List<StoreDto>>(rawStores);
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error al cargar sucursales: {ex.Message}", false);
        }
        finally
        {
            isLoading = false;
        }
    }

    private void OpenCreateModal()
    {
        isEditing = false;
        createModel = new CreateStoreDto
        {
            IdStoreType = availableTypes.FirstOrDefault()?.IdStoreType ?? 1
        };
        showModal = true;
    }

    private void OpenEditModal(StoreDto store)
    {
        isEditing = true;
        selectedStoreId = store.IdStore;
        updateModel = new UpdateStoreDto
        {
            Name = store.Name,
            Description = store.Description,
            IsActive = store.IsActive,
            IdStoreType = store.IdStoreType
        };
        showModal = true;
    }

    private void CloseModal()
    {
        showModal = false;
        isSaving = false;
    }

    private async Task HandleCreate()
    {
        isSaving = true;
        try
        {
            if (await StoreRepository.StoreExistsAsync(createModel.Name))
            {
                ShowFeedback("Ya existe una sucursal con ese nombre.", false);
                isSaving = false;
                return;
            }

            var store = Mapper.Map<Store>(createModel);
            var success = await StoreRepository.CreateStoreAsync(store);

            if (success)
            {
                ShowFeedback("Sucursal registrada exitosamente.", true);
                CloseModal();
                await LoadStoresAsync();
            }
            else
            {
                ShowFeedback("No se pudo guardar la sucursal en la base de datos.", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
        }
    }

    private async Task HandleUpdate()
    {
        isSaving = true;
        try
        {
            var existingStore = await StoreRepository.GetStoreAsync(selectedStoreId);
            if (existingStore == null)
            {
                ShowFeedback("No se encontró la sucursal a actualizar.", false);
                return;
            }

            if (!string.Equals(existingStore.Name.Trim(), updateModel.Name.Trim(), StringComparison.OrdinalIgnoreCase) &&
                await StoreRepository.StoreExistsAsync(updateModel.Name))
            {
                ShowFeedback("Ya existe otra sucursal con ese nombre.", false);
                return;
            }

            var store = Mapper.Map<Store>(updateModel);
            store.IdStore = selectedStoreId;
            store.CreationDate = existingStore.CreationDate;

            var success = await StoreRepository.UpdateStoreAsync(store);

            if (success)
            {
                ShowFeedback("Sucursal actualizada exitosamente.", true);
                CloseModal();
                await LoadStoresAsync();
            }
            else
            {
                ShowFeedback("No se pudo actualizar la sucursal.", false);
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error: {ex.Message}", false);
        }
        finally
        {
            isSaving = false;
        }
    }

    private void OpenDeleteModal(StoreDto store)
    {
        storeToDelete = store;
        showDeleteModal = true;
    }

    private void CloseDeleteModal()
    {
        showDeleteModal = false;
        storeToDelete = null;
        isDeleting = false;
    }

    private async Task ExecuteDeleteAsync()
    {
        if (storeToDelete == null) return;

        isDeleting = true;
        try
        {
            var entity = await StoreRepository.GetStoreAsync(storeToDelete.IdStore);
            if (entity != null)
            {
                var success = await StoreRepository.DeleteStoreAsync(entity);
                if (success)
                {
                    ShowFeedback($"Sucursal '{storeToDelete.Name}' eliminada correctamente.", true);
                    CloseDeleteModal();
                    await LoadStoresAsync();
                }
                else
                {
                    ShowFeedback("No se pudo eliminar la sucursal.", false);
                }
            }
        }
        catch (Exception ex)
        {
            ShowFeedback($"Error: {ex.Message}", false);
        }
        finally
        {
            isDeleting = false;
        }
    }

    private void ShowFeedback(string message, bool isSuccess)
    {
        feedbackMessage = message;
        feedbackClass = isSuccess ? "alert-success" : "alert-danger";
        feedbackIcon = isSuccess ? "bi-check-circle" : "bi-exclamation-triangle";
    }
}
